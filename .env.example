# G.A.T.E. Assessment -- example environment
# Copy to .env.local and fill in real values.

# Database (Neon) -- pooled connection string
DATABASE_URL="postgresql://user:password@host.neon.tech/db?sslmode=require"

# Email (Resend) -- https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="G.A.T.E. Assessment <noreply@example.com>"

# Better Auth -- generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe -- https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cloudflare R2 -- https://dash.cloudflare.com/?to=/:account/r2
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="gate-documents"
# Public URL for question images -- enable "Public access" on your R2 bucket, then copy the r2.dev URL
# e.g. https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_URL=""

# Certificate Verification Portal
# HMAC secret for certificate-code tamper detection (>=32 random bytes)
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_HMAC_SECRET=""
# Daily-rotated salt input for hashing verifier IPs (privacy-preserving log)
IP_HASH_SALT=""
# Comma-separated API keys for partner /api/v1/verify/bulk access
VERIFY_API_KEYS=""
# Optional: base URL embedded in certificate QR codes.
# Defaults to NEXT_PUBLIC_APP_URL, but useful to point local dev QR codes at prod.
CERT_VERIFY_BASE_URL=""

# Cloudflare Turnstile (CAPTCHA after N failed verify attempts)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Partner integrations (ArcMC) — exam authoring + SSO delivery
# AES-256 key (32 bytes) for encrypting partner shared/webhook secrets at rest.
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_SECRET_ENC_KEY=""
# Clock tolerance (seconds) when verifying partner JWT launch tokens.
PARTNER_JWT_LEEWAY_SECONDS="30"
# Domain used for synthetic emails of partner-managed student accounts.
PARTNER_SYNTHETIC_EMAIL_DOMAIN="students.arcmc.partner.gate"
# Outbound webhook request timeout (ms).
PARTNER_WEBHOOK_TIMEOUT_MS="10000"
# Shared secret protecting the webhook-retry cron route (Authorization: Bearer ...).
PARTNER_WEBHOOK_CRON_SECRET=""